    {
      "id": "itm_potion",
      "name": "Potion",
      "category": "Consumable",
      "description": "Restores a small amount of HP.",
      "lore": "A staple tonic passed between green adventurers and veteran hunters alike.",
      "defaultAmount": 2
    },
    {
      "id": "itm_hi_potion",
      "name": "Hi-Potion",
      "category": "Consumable",
      "description": "Restores a moderate amount of HP.",
      "lore": "A stronger curative kept close for the sort of mistakes one only makes once.",
      "defaultAmount": 2
    },
    {
      "id": "itm_ether",
      "name": "Ether",
      "category": "Consumable",
      "description": "Restores a small amount of MP.",
      "lore": "Bitter on the tongue, but prized by mages for the calm it brings back to the flow of aether.",
      "defaultAmount": 2
    },
    {
      "id": "itm_elixir",
      "name": "Elixir",
      "category": "Consumable",
      "description": "Restores HP and MP.",
      "lore": "Rare enough that most would rather boast of owning one than actually drink it.",
      "defaultAmount": 1
    },
    {
      "id": "itm_iron_ore",
      "name": "Iron Ore",
      "category": "Gathering",
      "description": "A decent-sized piece of rock containing the metal iron.",
      "lore": "A common but dependable ore, dark and heavy with possibility.",
      "defaultAmount": 3
    },
    {
